{
  "name": "aurelle",
  "private": true,
  "version": "0.1.0",
  "description": "Aurelle: a premium local shopping app (Stage 1 foundation).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "npm run typecheck && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "test": "playwright test",
    "test:install": "playwright install chromium",
    "verify": "npm run build && npm test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.35.0",
    "typescript": "~6.0.3",
    "vite": "^7.1.0"
  }
}
